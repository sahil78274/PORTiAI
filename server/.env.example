# ---------------------------------------------------------------
# PortiAI backend — example environment configuration
# Copy to server/.env and fill in your own values.
# Never commit server/.env to GitHub.
# ---------------------------------------------------------------

# Server port (Render provides PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# ---------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------
# Portfolio AI and the AI Project Builder use SEPARATE Gemini keys so one
# feature cannot exhaust the other's quota. The old GEMINI_API_KEY name is
# still accepted as a fallback for both, but dedicated keys are recommended.
AI_PROVIDER=gemini

# Portfolio features: bios, summaries, project descriptions, analysis.
GEMINI_PORTFOLIO_API_KEY=
GEMINI_PORTFOLIO_MODEL=gemini-2.5-flash

# AI Project Builder: file/code generation. Use a Flash or Flash-Lite model.
GEMINI_PROJECT_API_KEY=
GEMINI_PROJECT_MODEL=gemini-2.5-flash
# Control hidden "thinking" so the whole output budget is available for
# JSON/files. On Gemini 2.5 this sends thinkingBudget: 0. Gemini 3.x cannot
# fully disable thinking, so 0 is mapped to thinkingLevel: "low". -1 keeps the
# provider default. Unsupported/unknown models get no thinkingConfig at all.
GEMINI_PROJECT_THINKING_BUDGET=0

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Legacy single-key fallback (used only when the dedicated keys above are empty)
# GEMINI_API_KEY=

GEMINI_TIMEOUT_MS=25000
AI_PROVIDER_TIMEOUT_MS=75000
AI_PROJECT_TIMEOUT_MS=240000
AI_PROVIDER_RETRIES=1
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_PROJECT_API_BASE_URL=https://generativelanguage.googleapis.com

# Optional when AI_PROVIDER=openai (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model override for the project builder with AI_PROVIDER=openai.
AI_MODEL=

# AI Project Builder limits. Credits reset on the 1st of each month.
AI_PROJECT_CREDITS_MONTHLY=20

# Comma-separated browser origins allowed to call the API, without a trailing
# slash. These are the only origins accepted with credentials in production.
# https://portiai-frontend.onrender.com is always allowed by the code, so this
# only needs the *extra* origins (e.g. a Vercel deployment).
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Replace with a long, random secret in your private environment
SESSION_SECRET=replace-with-a-long-random-secret

SESSION_DAYS=7
AI_DAILY_REQUEST_CAP=200
AI_RATE_LIMIT_PER_MIN=12

# Use local MongoDB only for local development when configured
USE_LOCAL_MONGO=0
LOCAL_MONGO_PATH=.data/mongodb
# ---------------------------------------------------------------
# Premium pricing  ← CONFIGURE BEFORE LAUNCH
# ---------------------------------------------------------------
# Every price is created server-side from these values (single source of truth:
# server/src/config/pricing.js). The browser can never send an amount.
#   Monthly: ₹9 for the first month (one-time), then ₹299/month recurring
#   Yearly:  ₹3,050/year, compared with ₹3,588 at the monthly rate (15% off)
# Leave them empty to use the published defaults above.
PREMIUM_PRICE_INTRO=9
PREMIUM_PRICE_MONTHLY=299
PREMIUM_PRICE_YEARLY=3050
PREMIUM_PRICE_YEARLY_ORIGINAL=3588
PREMIUM_CURRENCY=INR

# ---------------------------------------------------------------
# Razorpay  ← REQUIRED FOR ONLINE PAYMENTS
# ---------------------------------------------------------------
# Create these at https://dashboard.razorpay.com → Settings → API Keys.
# KEY_SECRET and WEBHOOK_SECRET must never be exposed to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to add in the Razorpay dashboard:
#   https://<your-api-host>/api/subscription/webhook/razorpay
# Subscribe to: payment.captured, payment.failed, subscription.charged,
# subscription.cancelled, subscription.halted, subscription.completed.
# Copy the signing secret Razorpay shows into this value.
RAZORPAY_WEBHOOK_SECRET=

# Optional: reuse existing Razorpay plan ids instead of creating a plan on the
# first monthly/yearly purchase. Safe to leave empty.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=
# Billing-cycle counts for created plans (monthly plan: 120 months ≈ 10 years).
RAZORPAY_MONTHLY_TOTAL_COUNT=120
RAZORPAY_YEARLY_TOTAL_COUNT=20
# RAZORPAY_API_BASE_URL=https://api.razorpay.com
# RAZORPAY_TIMEOUT_MS=20000

# ---------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------
# Comma-separated emails that can open /admin/* and /api/admin/*.
# These accounts are also auto-promoted to role=admin at sign-in. Leave empty
# to grant access only via the provisioning script below.
ADMIN_EMAILS=

# Initial administrator provisioning (used once by scripts/grant-admin.mjs).
# These are read only by that script — they are never used by the server at
# runtime and must never be committed with real values.
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-strong-password' node scripts/grant-admin.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------------------------------------------------------------
# Billing (optional)
# ---------------------------------------------------------------
# Shared secret for POST /api/subscription/webhook, which a billing
# provider's server calls to set a plan AFTER a verified payment.
# Leave empty to disable the endpoint (it returns 501) — premiums are
# then provisioned with
# `node scripts/grant-premium.mjs --email user@example.com --plan premium`.
BILLING_WEBHOOK_SECRET=

# Hosted checkout URLs for the payment provider. When either is set, the
# Upgrade button redirects there (POST /api/subscription/checkout returns
# the URL). The plan itself is still activated only by the webhook above,
# never by the return URL.
BILLING_CHECKOUT_URL_MONTHLY=
BILLING_CHECKOUT_URL_YEARLY=

# Development only: lets a signed-in user activate Premium without a
# payment provider so the unlock flow can be tested end to end.
# Defaults to enabled outside production and is always disabled when
# NODE_ENV=production, whatever this value says.
BILLING_DEV_UPGRADE=true
