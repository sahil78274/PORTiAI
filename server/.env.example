# ---------------------------------------------------------------
# PortiAI backend — copy to server/.env and fill in real values.
# Never commit .env
# ---------------------------------------------------------------

# Port the API listens on (Render sets this automatically)
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portiai?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Gemini API key from https://aistudio.google.com/apikey  (server-side only)
GEMINI_API_KEY=your_gemini_api_key
# Any Flash / Flash-Lite model enabled for your API key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# Long random string: openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_secret

# Optional
SESSION_DAYS=7
AI_DAILY_REQUEST_CAP=200
# Per-account AI requests allowed per minute
AI_RATE_LIMIT_PER_MIN=12
# Development only: start a local MongoDB when MONGODB_URI is empty
USE_LOCAL_MONGO=0
LOCAL_MONGO_PATH=.data/mongodb
