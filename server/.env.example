# ---------------------------------------------------------------
# PortiAI backend — example environment configuration
# Copy to server/.env and fill in your own values.
# Never commit server/.env to GitHub.
# ---------------------------------------------------------------

# Server port (Render provides PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# Gemini API key — configure privately in server/.env / Render
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000

# Comma-separated browser origins allowed to call the API, without a trailing
# slash. These are the only origins accepted with credentials in production.
# https://portiai-frontend.onrender.com is always allowed by the code, so this
# only needs the *extra* origins (e.g. a Vercel deployment).
CLIENT_URL=http://localhost:5173,http://localhost:4173

# Replace with a long, random secret in your private environment
SESSION_SECRET=replace-with-a-long-random-secret

SESSION_DAYS=7
AI_DAILY_REQUEST_CAP=200
AI_RATE_LIMIT_PER_MIN=12

# Use local MongoDB only for local development when configured
USE_LOCAL_MONGO=0
LOCAL_MONGO_PATH=.data/mongodb
# ---------------------------------------------------------------
# Premium pricing  ← CONFIGURE BEFORE LAUNCH
# ---------------------------------------------------------------
# Every price shown on /premium comes from these values (single source
# of truth: server/src/config/pricing.js). If they are left empty the
# API falls back to *indicative* amounts and reports
# `pricing.source = "default"`, which the UI labels as an indicative
# price. Set real amounts here to remove that note.
PREMIUM_PRICE_MONTHLY=
PREMIUM_PRICE_YEARLY=
PREMIUM_CURRENCY=INR

# ---------------------------------------------------------------
# Billing (optional)
# ---------------------------------------------------------------
# Shared secret for POST /api/subscription/webhook, which a billing
# provider's server calls to set a plan AFTER a verified payment.
# Leave empty to disable the endpoint (it returns 501) — premiums are
# then provisioned with
# `node scripts/grant-premium.mjs --email user@example.com --plan premium`.
BILLING_WEBHOOK_SECRET=

# Hosted checkout URLs for the payment provider. When either is set, the
# Upgrade button redirects there (POST /api/subscription/checkout returns
# the URL). The plan itself is still activated only by the webhook above,
# never by the return URL.
BILLING_CHECKOUT_URL_MONTHLY=
BILLING_CHECKOUT_URL_YEARLY=

# Development only: lets a signed-in user activate Premium without a
# payment provider so the unlock flow can be tested end to end.
# Defaults to enabled outside production and is always disabled when
# NODE_ENV=production, whatever this value says.
BILLING_DEV_UPGRADE=true
