# Base URL of the backend API, including the /api prefix.
# Leave empty to use a relative /api path (works with the Vite dev proxy and
# with a reverse proxy that forwards /api to the backend).
VITE_API_BASE_URL=http://localhost:5000/api

# Deployed frontend (Render/Vercel) — set this in the hosting dashboard instead
# of committing it. It is compiled into the bundle, so changing it requires a
# rebuild:
#
#   VITE_API_BASE_URL=https://portiai-backend.onrender.com/api
